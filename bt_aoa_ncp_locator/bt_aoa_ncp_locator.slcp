configuration:
- name: SL_STACK_SIZE
  value: '2752'
- name: SL_BT_CONFIG_USER_ADVERTISERS
  value: '4'
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: SL_UARTDRV_USART_VCOM_FLOW_CONTROL_TYPE
