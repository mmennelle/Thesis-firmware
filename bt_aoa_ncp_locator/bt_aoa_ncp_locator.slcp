# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: bt_aoa_ncp_locator
label: bt_aoa_ncp_locator
description: |
  Network Co-Processor (NCP) target application extended with CTE Receiver support. It enables Angle of Arrival (AoA) calculation. Use this application with Direction Finding host examples.
category: Bluetooth AoX Examples
filter:
- name: Device Type
  value:
  - NCP
- name: Project Difficulty
  value:
  - Advanced
- name: Wireless Technology
  value:
  - Bluetooth
package: bluetooth_le_app
quality: production
readme:
- path: readme.md
source:
- path: app.c
tag:
- prebuilt_demo
- hwfilter:device:device_supports_bluetooth
- hwfilter:ram:32k
- hwfilter:board:hardware_board_has_rfswitch_aox
- hwfilter:device:device_series_2
- hwfilter:device:device_supports_bluetooth_antenna_switching
- hwfilter:device:device_supports_bluetooth_cte
- hwfilter:device:device_supports_bluetooth_iq_sampling
sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2025.12.1
